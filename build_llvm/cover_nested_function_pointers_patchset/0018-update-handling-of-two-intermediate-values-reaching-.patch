Subject: [PATCH 18/19] update handling of two intermediate values reaching an
 Fpointer to consider arbitrary nested vacuous struct chains

---
 .../Instrumentation/SanitizerCoverage.cpp     | 70 +++++++++++--------
 1 file changed, 41 insertions(+), 29 deletions(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index 2a29c26659cd..bfbc2bd0db65 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -1239,6 +1239,39 @@ bool areStructTypesCompatible(llvm::Type *Left, llvm::Type *Right) {
     return false;
 }
 
+bool typeChainIsChild(Types &ChildTys, Types &ParentTys, Offsets &ParentOffs){
+  /* If the leading types are not variations of the same type,
+   * try to assume the following:
+   * There is a nested type signature where both A and B can
+   * reach the same function pointer, and A is stored at the
+   * beginning of B.
+   *   struct A {int c; (void)() fn_ptr};
+   *   Struct B {struct A inner_a; int d};
+   *
+   * The store instruction is of the shape:
+   *   struct A* ptr_a = &ptr_b.inner_a
+   *
+   * This means the stored value can have either the type B or A,
+   *  and reach the same function pointer through both.
+   *
+   * Nevertheless, it's only type A that we care about.
+   * Going through B is an extra step that we can delete.
+   * So, try to identify that both chains share the same types near the beginning,
+   * and that every similar type appears at the beginning of the next struct. */
+  Type *FirstChildTy = *(ChildTys.rbegin());
+  auto ChildTyIt = std::find(ParentTys.rbegin(), ParentTys.rend(), FirstChildTy);
+  if (ChildTyIt == ParentTys.rend()){
+    return false;
+  }
+  Types FirstTys = Types(ParentTys.rbegin(), next(ChildTyIt));
+  Offsets FirstOffs = Offsets(ParentOffs.rbegin(), ParentOffs.rbegin() + FirstTys.size());
+  for (unsigned i=0; i<FirstTys.size(); i++){
+    if (!FirstTys[i]->isStructTy() || FirstOffs[i] != 0)
+      return false;
+  }
+  return true;
+}
+
 // declared here for recursion purposes.
 retType handleTypeRecursiveImpl(Type *Ty, Types &Visited, DenseMap<Type*, retType> &ResultCache);
 
