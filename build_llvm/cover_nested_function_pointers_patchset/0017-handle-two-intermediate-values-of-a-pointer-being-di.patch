Subject: [PATCH 17/19] handle two intermediate values of a pointer being
 differently specified instances of the same type

---
 .../Instrumentation/SanitizerCoverage.cpp     | 73 ++++++++++++++++---
 1 file changed, 63 insertions(+), 10 deletions(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index 42c9f1e0d2f6..2a29c26659cd 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -1202,6 +1202,43 @@ retType getOffsetsFromFunctionPointerType(Type *FunctionType) {
   return std::make_pair(true, Res);
 }
 
+bool isEmptyStructTy(Type *Ty){
+  if (StructType *STy = dyn_cast<StructType>(Ty))
+    return STy->isOpaque() || (STy->isLiteral() && STy->getNumElements() == 0);
+  return false;
+}
+
+bool areStructTypesCompatible(llvm::Type *Left, llvm::Type *Right) {
+    // Base case: Exact pointer match
+    if (Left == Right)
+        return true;
+    // Base case: One is an empty struct//opaque pointer
+    if (isEmptyStructTy(Left) || isEmptyStructTy(Right))
+        return true;
+    // Recursive case: Structs
+    if (StructType *SLeft = dyn_cast<llvm::StructType>(Left)){
+      if (StructType *SRight = dyn_cast<llvm::StructType>(Right)){
+        if (SLeft->getNumElements() != SRight->getNumElements())
+          return false;
+        bool AllCompatible = true;
+        for (unsigned i = 0; i < SLeft->getNumElements(); ++i) {
+          AllCompatible = AllCompatible && areStructTypesCompatible(
+                                          SLeft->getElementType(i),
+                                          SRight->getElementType(i));
+        }
+        return AllCompatible;
+      }
+    }
+    // Recursive case: Pointers
+    if (Left->isPointerTy() && Right->isPointerTy()) {
+      return areStructTypesCompatible(Left->getPointerElementType(),
+                                      Right->getPointerElementType());
+    }
+
+    // If types differ fundamentally (e.g. i32 vs struct) and aren't covered above
+    return false;
+}
+
 // declared here for recursion purposes.
 retType handleTypeRecursiveImpl(Type *Ty, Types &Visited, DenseMap<Type*, retType> &ResultCache);
 
@@ -1380,6 +1417,7 @@ retType getRecursiveOffsetsFromAllValues(ArrayRef<Value *> PossibleStoredValues,
   std::vector<retType> Res = {};
   std::vector<int> PositiveResultIdxs = {};
 
+  // Hands-off to main algorithm
   for (unsigned i = 0; i < PossibleStoredValues.size(); i++) {
     Type *StoredType = PossibleStoredValues[i]->getType();
     retType PartialRes = handleTypeRecursive(StoredType, RetTypeCache);
@@ -1391,42 +1429,57 @@ retType getRecursiveOffsetsFromAllValues(ArrayRef<Value *> PossibleStoredValues,
     Res.push_back(PartialRes);
   }
 
+  // Edge case handling for various sizes of PossibleStoredValues
   if (Any == 1) {
     return std::make_pair(true, Res[PositiveResultIdxs[0]].second);
   }
   // TO DO: not have this weakness
   if (Any == 2){
-    /* Try to assume the following:
+    Types FirstTypeChain = Res[PositiveResultIdxs[0]].second[0].first;
+    Types SecondTypeChain = Res[PositiveResultIdxs[1]].second[0].first;
+    if (areStructTypesCompatible(*FirstTypeChain.rbegin(),
+                                *SecondTypeChain.rbegin())){
+      // areStructTypesCompatible returns `true` for any combination
+      // of Left and Right being more specific than the other.
+      // (i.e, Left and Right can be {}* in one field while the other isn't)
+      // But we're going to assume of these types one is more specific.
+      // Hence, return the one that produced the most reachable fPointers.
+      if (FirstTypeChain.size() > SecondTypeChain.size())
+        return std::make_pair(true, Res[PositiveResultIdxs[0]].second);
+      return std::make_pair(true, Res[PositiveResultIdxs[1]].second);
+    }
+    /* If the leading types are not variations of the same type,
+    * try to assume the following:
     * There is a nested type signature where both A and B can
     * reach the same function pointer, and A is stored at the
     * beginning of B.
     *   struct A {int c; (void)() fn_ptr};
     *   Struct B {struct A inner_a; int d};
     *
-    * If we retrieve the inner_a we get a pointer that can
-    * have both the types A and B and can reach a function pointer
-    * through either:
+    * The store instruction is of the shape:
     *   struct A* ptr_a = &ptr_b.inner_a
     *
+    * This means the stored value can have either the type B or A,
+    *  and reach the same function pointer through both.
+    *
     * Nevertheless, it's only type A that we care about.
     * Going through B is an extra step that we can delete.
     * So, try to identify that both chains share a type near the beginning,
     * and keep only the smaller of those chains.
     */
-    Types firstTypeChain = Res[PositiveResultIdxs[0]].second[0].first;
-    Types secondTypeChain = Res[PositiveResultIdxs[1]].second[0].first;
-    Type *FirstOfFirstTC = *(firstTypeChain.rbegin());
-    Type *SecondOfSecondTC = *(next(secondTypeChain.rbegin()));
+    Type *FirstOfFirstTC = *(FirstTypeChain.rbegin());
+    Type *SecondOfSecondTC = *(next(SecondTypeChain.rbegin()));
     if (FirstOfFirstTC == SecondOfSecondTC){
       // we assume the chain starting with B would appear second in Res,
       // and looks like {Struct B, Struct A, ...}
       return std::make_pair(true, Res[PositiveResultIdxs[0]].second);
     }
+    // All edge case handling fails: panic accordingly.
     std::string ErrMsg;
     raw_string_ostream ROS(ErrMsg);
     ROS << "Two intermediate values reach a function pointer. Example:\nStored Types=["
-        << **firstTypeChain.rbegin() << ", " << **secondTypeChain.rbegin() << "]\n Reachable Function Types=["
-        << **firstTypeChain.begin() << ", " <<  **secondTypeChain.begin() << "]\n";
+        << **FirstTypeChain.rbegin() << ", " << **SecondTypeChain.rbegin() << "]\n Reachable Function Types=["
+        << **FirstTypeChain.begin() << ", " <<  **SecondTypeChain.begin() << "]\n";
     report_fatal_error(StringRef(ErrMsg));
   }
   if (Any > 2){
