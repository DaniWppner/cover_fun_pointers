From 401e6eb1d00511bbcda2453f829cd0239a4ac054 Mon Sep 17 00:00:00 2001
From: Daniel Wappner <dwappner@dc.uba.ar>
Date: Mon, 16 Nov 2026 13:16:48 -0300
Subject: [PATCH 21/21] rework shallow pointers to pass the offsets directly to
 the callback, without computing any LOADs

---
 .../Instrumentation/SanitizerCoverage.cpp     | 65 +++++++++++--------
 1 file changed, 38 insertions(+), 27 deletions(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index db5ca008a9ec..f95c02869035 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -303,7 +303,8 @@ private:
   void InjectShallowOrNakedFuncPointerCallback(TraceInstrumentTarget Target);
   void InjectNestedFuncPointerCallback(TraceInstrumentTarget Target);
   void InjectFuncPointerCallbackAtShallowStruct(TraceInstrumentTarget Target);
-  CallInst *InjectFuncPointerCallback(Value *StorePtr, Value *StoredValue,
+  CallInst *InjectFuncPointerCallback(Value *StorePtr, Value *Val,
+                                      ArrayRef<uint64_t> ByteOffsets,
                                       IRBuilder<> &Builder);
   Value *InjectStructElemLoad(IRBuilder<> &IRB, Value *StructPointer,
                               Type *StructType, Type *ElemType,
@@ -580,7 +581,8 @@ bool ModuleSanitizerCoverage::instrumentModule(
       M.getOrInsertFunction(SanCovStore16, VoidTy, Int128PtrTy);
 
   SanCovStoreFPointerFunction =
-      M.getOrInsertFunction(SanCovStoreFunPointer, VoidTy, IntptrTy, IntptrTy);
+      M.getOrInsertFunction(SanCovStoreFunPointer, VoidTy, IntptrTy, IntptrTy,
+                            IntptrTy, IntptrTy);
 
   {
     AttributeList AL;
@@ -1581,12 +1583,12 @@ void ModuleSanitizerCoverage::InjectShallowOrNakedFuncPointerCallback(
       IRB.SetCurrentDebugLocation(Target.SI->getDebugLoc());
 
     InjectFuncPointerCallback(Target.SI->getPointerOperand(),
-                              Target.SI->getValueOperand(), IRB);
+                              Target.SI->getValueOperand(), {}, IRB);
   } else {
     /*
      * Depth 1: Struct containing function pointers.
-     * We evaluate the GEP to get the address of the function pointer inside the
-     * struct, and load it to get the actual function pointer.
+     * We pass the struct pointer and the byte offset of the function pointer
+     * field; the runtime loads the function pointer if it is safe to do so.
      */
     assert(
         Target.OffsetChain.size() == 3 &&
@@ -1595,18 +1597,23 @@ void ModuleSanitizerCoverage::InjectShallowOrNakedFuncPointerCallback(
   }
 }
 
-// call the run-time function __sanitizer_cov_store_fun_pointer* with two
+// call the run-time function __sanitizer_cov_store_fun_pointer with four
 // parameters:
 //   - address of the variable being written to,
-//   - function pointer reachable through the value written.
+//   - value written (a function pointer, or a pointer to a struct holding one),
+//   - number of byte offsets the runtime must follow to get to the function pointer,
+//   - byte offset of the function pointer field inside the struct (0 if none).
 CallInst *ModuleSanitizerCoverage::InjectFuncPointerCallback(
-    Value *StorePtr, Value *StoredValue, IRBuilder<> &Builder) {
-  CallInst *Res =
-      Builder.CreateCall(SanCovStoreFPointerFunction,
-                         {
-                             Builder.CreatePointerCast(StorePtr, IntptrTy),
-                             Builder.CreatePointerCast(StoredValue, IntptrTy),
-                         });
+    Value *StorePtr, Value *Val, ArrayRef<uint64_t> ByteOffsets,
+    IRBuilder<> &Builder) {
+  CallInst *Res = Builder.CreateCall(
+      SanCovStoreFPointerFunction,
+      {
+          Builder.CreatePointerCast(StorePtr, IntptrTy),
+          Builder.CreatePointerCast(Val, IntptrTy),
+          ConstantInt::get(IntptrTy, ByteOffsets.size()),
+          ConstantInt::get(IntptrTy, ByteOffsets.empty() ? 0 : ByteOffsets[0]),
+      });
   Res->setCannotMerge(); // gets the PC using GET_CALLER_PC.
   return Res;
 }
@@ -1652,21 +1659,22 @@ void ModuleSanitizerCoverage::InjectFuncPointerCallbackAtShallowStruct(TraceInst
 
   Value *StoredValue = Target.SI->getValueOperand()->stripPointerCastsAndAliases();
   Value *StorePtr = Target.SI->getPointerOperand();
-  Type *FPointerType = Target.TypeChain[1];
   Type *StructType = Target.TypeChain[2];
   unsigned Offset = Target.OffsetChain[1];
   // Here we assume:
   //    TypeChain has the form {FType, Pointer to FType, StructType}
   //    OffsetChain has the form {0, Index in the Struct, 0}
   //    StoredValue is a a pointer to the base of a StructType.
+  // StructType may come from any value getAllValuesThatWouldBeStripped
+  // returns; they are all pointer casts or all-zero GEPs of StoredValue, so
+  // they share its address.
+  uint64_t ByteOffset = DL->getStructLayout(cast<llvm::StructType>(StructType))
+                            ->getElementOffset(Offset);
 
   IRBuilder<> IRB(Target.BB->getTerminator());
-  DebugLoc EntryLoc = Target.SI->getDebugLoc();
-  if (EntryLoc)
-    IRB.SetCurrentDebugLocation(EntryLoc);
-  Value * ShallowStructPointer = castMiscPointerIntoItsStructType(IRB, StoredValue, StructType);
-  Value * FunctionPtr = InjectStructElemLoad(IRB, ShallowStructPointer, StructType, FPointerType, {0,Offset});
-  InjectFuncPointerCallback(StorePtr, FunctionPtr, IRB);
+  if (Target.SI->getDebugLoc())
+    IRB.SetCurrentDebugLocation(Target.SI->getDebugLoc());
+  InjectFuncPointerCallback(StorePtr, StoredValue, {ByteOffset}, IRB);
 }
 
 void ModuleSanitizerCoverage::InjectFuncPointerTracesAtBlocks(
@@ -1697,7 +1705,7 @@ void ModuleSanitizerCoverage::InjectNestedFuncPointerCallback(TraceInstrumentTar
   if (! ((*Target.TypeChain.rbegin())->isStructTy())){
     //else: this is a naked reachable function pointer
     InjectFuncPointerCallback(Target.SI->getPointerOperand(),
-                              Target.SI->getValueOperand(), IRB);
+                              Target.SI->getValueOperand(), {}, IRB);
     return;
   }
 
@@ -1762,13 +1770,14 @@ void ModuleSanitizerCoverage::InjectNestedFuncPointerCallback(TraceInstrumentTar
     report_fatal_error(StringRef(ErrMsg));
   }
 
-  InjectFuncPointerCallback(Target.SI->getPointerOperand(), CurrBasePointer, IRB);
+  InjectFuncPointerCallback(Target.SI->getPointerOperand(), CurrBasePointer, {}, IRB);
 }
 
 // On every store to a function pointer variable call we call a run-time
-// function __sanitizer_cov_store_fun_pointer* with two parameters:
+// function __sanitizer_cov_store_fun_pointer with parameters:
 //   - address of the variable,
-//   - stored function pointer
+//   - stored function pointer,
+//   - 0 offsets, offset 0
 void ModuleSanitizerCoverage::InjectTraceForNakedFunctionPointerStores(Function &F, ArrayRef<StoreInst *> Stores) {
   json::Object DebugDump;
   fillJsonWithFunctionInfo(F, DebugDump);
@@ -1798,9 +1807,11 @@ void ModuleSanitizerCoverage::InjectTraceForNakedFunctionPointerStores(Function
 }
 
 // On every store to a function pointer variable call we call a run-time
-// function __sanitizer_cov_store_fun_pointer* with two parameters:
+// function __sanitizer_cov_store_fun_pointer with parameters:
 //   - address of the variable,
-//   - stored function pointer
+//   - stored value,
+//   - 0 offsets for a function pointer, 1 for a struct pointer,
+//   - byte offset of the function pointer field inside the struct.
 void ModuleSanitizerCoverage::InjectTraceForShallowFunctionPointerStores(
     Function &F, ArrayRef<StoreInst *> Stores) {
   json::Array StoreInstInfoArray;
