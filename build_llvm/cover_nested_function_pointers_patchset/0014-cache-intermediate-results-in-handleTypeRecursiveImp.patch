   while (itTy != Target.TypeChain.rend()){
+    iterCount ++;
 
     if ((*itTy)->isPointerTy()){
     // itTy is pointer to Function (end of chain) OR pointer to Struct.
@@ -1568,11 +1592,25 @@ void ModuleSanitizerCoverage::InjectNestedFuncPointerCallback(TraceInstrumentTar
 
