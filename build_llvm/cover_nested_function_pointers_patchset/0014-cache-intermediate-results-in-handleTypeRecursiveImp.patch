   Type *PointeeType = Ty->getPointerElementType();
   //recursive case
   if (StructType *STy = dyn_cast<StructType>(PointeeType)){
-    retType StructRes = handleTypeRecursiveImpl(STy, Visiting);
+    retType StructRes = handleTypeRecursiveImpl(STy, Visiting, ResultCache);
     return makePointerToStructResFromStructRes(StructRes, STy);
   }
   // base cases
@@ -1269,12 +1286,15 @@ retType recursivelyHandlePointerType(PointerType *Ty, Types &Visiting) {
 }
 
 
-retType handleTypeRecursiveImpl(Type *Ty, Types &Visiting) {
+retType handleTypeRecursiveImpl(Type *Ty, Types &Visiting, DenseMap<Type*, retType> &ResultCache) {
+  if (auto itResult = ResultCache.find(Ty); itResult != ResultCache.end()){
+    return itResult->getSecond();
+  }
   Visiting.push_back(Ty);
   retType Result;
   if (StructType *OriginalStruct = dyn_cast<StructType>(Ty))
     // recursive: need to look into the struct's fields
-    Result = recursivelyHandleStructType(OriginalStruct, Visiting);
+    Result = recursivelyHandleStructType(OriginalStruct, Visiting, ResultCache);
 
   else if (!Ty->isPointerTy())
     // not a struct nor a pointer: this is a dead end.
@@ -1282,15 +1302,16 @@ retType handleTypeRecursiveImpl(Type *Ty, Types &Visiting) {
 
   else
     // assume pointer
-    Result = recursivelyHandlePointerType(dyn_cast<PointerType>(Ty), Visiting);
+    Result = recursivelyHandlePointerType(dyn_cast<PointerType>(Ty), Visiting, ResultCache);
 
+  ResultCache.insert(std::pair<Type*, retType>(Ty, Result));
   Visiting.pop_back();
   return Result;
 }
 
-retType handleTypeRecursive(Type *Ty) {
+retType handleTypeRecursive(Type *Ty,DenseMap<Type*, retType> &RetTypeCache) {
   Types Visited = {};
-  return handleTypeRecursiveImpl(Ty, Visited);
