+void debugTypeChainTraversal(raw_string_ostream &ROS, TraceInstrumentTarget &Target, Offsets &OffsToElem){
+  ROS <<  " .\n\tFirst type: " << **Target.TypeChain.rbegin() <<
+    " .\n\tLen of offset chain:" << size(OffsToElem) << "/" << size(Target.OffsetChain) << "\n";
+    if (size(Target.OffsetChain) < 10){
+    ROS << "TypeChain: ";
+    for (auto it = Target.TypeChain.rbegin(); it != prev(prev(Target.TypeChain.rend())); it++){
+      ROS << "\t" << (*it)->getStructName() << ",\n";
+    }
+    ROS << "\t" << *Target.TypeChain[1] << ",\n";
+    ROS << "\t" << *Target.TypeChain[0];
+    }
+}
