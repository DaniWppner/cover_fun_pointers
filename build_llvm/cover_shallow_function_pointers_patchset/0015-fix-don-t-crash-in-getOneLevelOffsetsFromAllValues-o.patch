From 5bb7297097dd1a8ffd118b83659285749ea8749e Mon Sep 17 00:00:00 2001
From: daniel wappner <dwappner@dc.uba.ar>
Date: Mon, 3 Aug 2026 15:24:40 -0300
Subject: [PATCH 15/15] fix: don't crash in getOneLevelOffsetsFromAllValues on
 nested pointers

---
 .../Transforms/Instrumentation/SanitizerCoverage.cpp  | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index 11d7d86d6..08ef4e9d2 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -13,6 +13,7 @@
 #include "llvm/Transforms/Instrumentation/SanitizerCoverage.h"
 #include "llvm/ADT/ArrayRef.h"
 #include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringRef.h"
 #include "llvm/Analysis/EHPersonalities.h"
 #include "llvm/Analysis/PostDominators.h"
 #include "llvm/IR/BasicBlock.h"
@@ -39,6 +40,7 @@
 #include "llvm/Support/Casting.h"
 #include "llvm/Support/CommandLine.h"
 #include "llvm/Support/Debug.h"
+#include "llvm/Support/ErrorHandling.h"
 #include "llvm/Support/JSON.h"
 #include "llvm/Support/SpecialCaseList.h"
 #include "llvm/Support/VirtualFileSystem.h"
@@ -1192,8 +1194,15 @@ getOneLevelOffsetsFromAllValues(ArrayRef<Value *> PossibleStoredValues) {
       // pointers
       return getOffsetsFromPointerToShallowStructType(STy);
     }
+    if (PointeeType->isPointerTy())
+      //we cannot handle double/triple/nested pointer types in this implementation
+      continue;
+
     // TODO: handle more types
-    assert(false && "Unexpected type during function pointer analysis.\n");
+    std::string ErrMsg;
+    raw_string_ostream ROS(ErrMsg);
+    ROS << "Unexpected type during function pointer analysis " << *PointeeType << " .\n";
+    report_fatal_error(StringRef(ErrMsg));
     // unreachable, but makes the compiler complain less
     return std::make_pair(false, vectorTypesXOffsets{});
   }
-- 
2.43.0

