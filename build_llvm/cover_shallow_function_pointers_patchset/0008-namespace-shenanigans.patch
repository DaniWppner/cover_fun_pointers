+  std::pair<Value *, Value *> getFunctionPointerAndAddressUsingOffsetChain(
+      Value *StorePtr, Value *StoredValue, Offsets offsetChain, Types typeChain,
+      IRBuilder<> &Builder) {
+
+    if (offsetChain.size() == 1) {
+      /*
+      * Depth 0: Naked function pointer.
+      * We return the original StorePtr as the address and the function pointer as the value.
+      */
+      assert(StoredValue->getType()->isPointerTy());
+      Type *DesiredFType = typeChain[0];
+      Type *MiscPointeeType = StoredValue->getType()->getPointerElementType();
+
+      Value *FunctionPtr = nullptr;
+      if (MiscPointeeType->isFunctionTy()) {
+        // We are already at the function pointer which we were looking for.
+        assert(MiscPointeeType == DesiredFType);
+        FunctionPtr = StoredValue;
+      } else {
+        // We have a pointer to a pointer to function.
+        // To retrieve the function pointer we just need to load once.
+        assert(MiscPointeeType->isPointerTy() &&
+              MiscPointeeType->getPointerElementType()->isFunctionTy() &&
+              MiscPointeeType->getPointerElementType() == DesiredFType);
+
+        // Address space hardcoded to 0 here because that's where function
+        // pointers usually live.
+        Type *FPointerType = PointerType::get(DesiredFType, 0);
+        FunctionPtr = Builder.CreateLoad(FPointerType, StoredValue);
+      }
+      return std::make_pair(StorePtr, FunctionPtr);
+
     } else {
-      // We have a pointer to a pointer to function.
-      // To retrieve the function pointer we just need to load once.
-      assert(MiscPointeeType->isPointerTy() &&
-             MiscPointeeType->getPointerElementType()->isFunctionTy() &&
-             MiscPointeeType->getPointerElementType() == DesiredFType);
-
-      // Address space hardcoded to 0 here because that's where function
-      // pointers usually live.
-      Type *FPointerType = PointerType::get(DesiredFType, 0);
-      FunctionPtr = Builder.CreateLoad(FPointerType, StoredValue);
+      /*
+      * Depth 1: Struct containing function pointers.
+      * We evaluate the GEP to get the address of the function pointer inside the struct,
+      * and load it to get the actual function pointer.
+      */
+      assert(offsetChain.size() == 2 && "Offset chain size must be 2 for depth 1 structs");
+      StoredValue = StoredValue->stripPointerCastsAndAliases();
+      int Offset = offsetChain[0];
+      Type *StructType = typeChain[0];
+      Type *ContainedType = typeChain[1];
+
+      unsigned AddrSpace = StoredValue->getType()->getPointerAddressSpace();
+      PointerType *StructPtrTy = PointerType::get(StructType, AddrSpace);
+
+      // We would prefer crashing if while traversing the struct chain we
+      // get a pointer to an unexpected type instead of casting it.
+      Value *Cast = Builder.CreatePointerCast(StoredValue, StructPtrTy);
+
+      Value *Address = Builder.CreateInBoundsGEP(
+          StructType, Cast,
+          {ConstantInt::get(Type::getInt32Ty(StoredValue->getContext()), 0),
+          ConstantInt::get(Type::getInt32Ty(StoredValue->getContext()), Offset)});
+
+      // The contained type in memory is a pointer to the function.
+      Type *ContainedPtrType = PointerType::get(ContainedType, 0);
+      Value *FunctionPtr = Builder.CreateLoad(ContainedPtrType, Address);
+
+      return std::make_pair(Address, FunctionPtr);
     }
-    return std::make_pair(StorePtr, FunctionPtr);
-
