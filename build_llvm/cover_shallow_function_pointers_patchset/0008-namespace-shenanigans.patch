-    Type *StoredType = PossibleStoredValues[i]->getType();
-    if (!StoredType->isPointerTy())
-      assert(false && "We only expect function pointer types here.\n");
-    Type *PointeeType = StoredType->getPointerElementType();
-    if (PointeeType->isFunctionTy()) {
-      // Depth 0: naked function pointer
-      return GetOffsetsFromFunctionType(PointeeType);
