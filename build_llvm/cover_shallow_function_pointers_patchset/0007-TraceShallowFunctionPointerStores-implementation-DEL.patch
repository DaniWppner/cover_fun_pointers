+
+static retType GetOffsetsFromShallowStructType(StructType *STy){
+  vectorTypesXOffsets Res;
+  for (unsigned j = 0; j < STy->getNumElements(); j++) {
+    Type *ElemType = STy->getElementType(j);
+    if (ElemType->isPointerTy() && ElemType->getPointerElementType()->isFunctionTy()) {
+      Res.push_back(std::make_pair(
+        Types{ElemType, STy},
+        Offsets{j, 0}
+      ));
+    }
+  }
+  if (!Res.empty()) {
+    return std::make_pair(true, Res);
+  }
+  return std::make_pair(false, Res);
+}
+
+static retType GetOffsetsFromFunctionType(Type* FunctionType){
+  vectorTypesXOffsets Res = {
+    std::make_pair(
+      Types{FunctionType},
+      Offsets{0}
+    )
+  };
+  return std::make_pair(true, Res);
 }
 
