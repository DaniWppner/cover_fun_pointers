+typedef std::vector<unsigned> Offsets;
+// TypesXOffsets represents the flattened path from Type `a` to a Type  `b`
+//  that can be reached through the nested Type structure `a`.
+//  (Type `a` is the last element in the Types array. Type `b` is the first.)
+//  For a given n: int, The last n elements in the Offsets array from back
+//  to front are the indexes used to traverse the nested Type structure `a`
+//  and reach the nth reachable Type in the Type array.
+typedef std::pair<Types, Offsets> TypesXOffsets;
+// vectorTypesXOffsets represents a vector of all the reachable interesting types,
+//  where each reachable interesting type has its corresponding TypesXOffsets entry
+typedef std::vector<TypesXOffsets> vectorTypesXOffsets;
+// retType represents whether a function pointer is reachable from a father type,
+// and the vectorTypesXOffsets to all reachable function pointers.
+typedef std::pair<bool, vectorTypesXOffsets> retType;
 
