From 4e367beb1953ee3563de8d5f9857e3c66f9b6bc1 Mon Sep 17 00:00:00 2001
From: daniel wappner <dwappner@dc.uba.ar>
Date: Wed, 29 Jul 2026 19:26:58 -0300
Subject: [PATCH 12/12] fix: don't include the path to a struct twice on struct
 pointer navigation

---
 llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index 9f828b44f..499ed8f54 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -1134,7 +1134,7 @@ retType getOffsetsFromShallowStructType(StructType *STy) {
     Type *ElemType = STy->getElementType(j);
     if (ElemType->isPointerTy() &&
         ElemType->getPointerElementType()->isFunctionTy()) {
-      Res.push_back(std::make_pair(Types{ElemType, STy}, Offsets{j, 0}));
+      Res.push_back(std::make_pair(Types{ElemType}, Offsets{j}));
     }
   }
   if (!Res.empty()) {
