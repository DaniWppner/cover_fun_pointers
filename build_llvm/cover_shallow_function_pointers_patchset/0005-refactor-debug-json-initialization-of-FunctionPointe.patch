From: daniel wappner <dwappner@dc.uba.ar>
Date: Mon, 27 Jul 2026 19:25:30 -0300
Subject: [PATCH 05/18] refactor debug json initialization of
 FunctionPointerStores InjectTrace functions

---
 .../Instrumentation/SanitizerCoverage.cpp     | 80 +++++++------------
 1 file changed, 30 insertions(+), 50 deletions(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index 97f934b0c9f7..782f21ebc9a1 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -257,7 +257,7 @@ private:
                                        json::Object &DebugDump,
                                        json::Array &StoreInstInfoArray,
                                        unsigned InstrumentedCount,
-                                       ArrayRef<Type *> FuncPointerArgTypes);
+                                       bool HaveFuncPointerArgTypes);
   void InjectTraceForSwitch(Function &F,
                             ArrayRef<Instruction *> SwitchTraceTargets);
   bool InjectCoverage(Function &F, ArrayRef<BasicBlock *> AllBlocks,
@@ -1011,8 +1011,16 @@ static void ShowElementVector(std::vector<T> genericVector) {
   errs() << "}\n";
 }
 
-static void putTypesIntoJson(SmallVector<Type *> &FuncPointerArgTypes,
-                             json::Object &RootJson) {
+static bool putFunctionArgFuncTypesIntoJson(Function &F,
+                                            json::Object &RootJson) {
+  SmallVector<Type *> FuncPointerArgTypes = {};
+  FunctionType *FType = F.getFunctionType();
+  for (Type *ParamType : FType->params()) {
+    if (ParamType->isPointerTy() &&
+        ParamType->getPointerElementType()->isFunctionTy()) {
+      FuncPointerArgTypes.push_back(ParamType);
+    }
+  }
   json::Array FunctionPointerParameters;
   for (Type *T : FuncPointerArgTypes) {
     std::string TypeStr;
@@ -1021,6 +1029,7 @@ static void putTypesIntoJson(SmallVector<Type *> &FuncPointerArgTypes,
     FunctionPointerParameters.push_back(RSO.str());
   }
   RootJson["functionPointerParameters"] = std::move(FunctionPointerParameters);
+  return !FuncPointerArgTypes.empty();
 }
 
 static void putStoreInstIntoJson(StoreInst *SI,
@@ -1058,14 +1067,14 @@ void ModuleSanitizerCoverage::InjectFuncPointerTracesAtBlocks(ArrayRef<std::pair
   json::Object &DebugDump,
   json::Array &StoreInstInfoArray,
   unsigned InstrumentedCount,
-  ArrayRef<Type *> FuncPointerArgTypes
+  bool HaveFuncPointerArgTypes,
 ){
   for (const std::pair<BasicBlock *, StoreInst *> &Item : BlocksToInstrument) {
     InjectFuncPointerTraceAtBlock(Item.first, Item.second);
   }
 
   DebugDump["InstrumentedStores"] = std::move(StoreInstInfoArray);
-  if (InstrumentedCount || FuncPointerArgTypes.size()) {
+  if (InstrumentedCount || HaveFuncPointerArgTypes) {
     json::Value FinalJson = std::move(DebugDump);
     std::error_code EC;
     raw_fd_ostream JSONOut("/tmp/naked_pointers.json", EC, sys::fs::OF_Append);
@@ -1079,49 +1088,30 @@ void ModuleSanitizerCoverage::InjectFuncPointerTracesAtBlocks(ArrayRef<std::pair
 //   - stored function pointer
 void ModuleSanitizerCoverage::InjectTraceForNakedFunctionPointerStores(
     Function &F, ArrayRef<StoreInst *> Stores) {
-
-  SmallVector<Type *> FuncPointerArgTypes = {};
-  FunctionType *FType = F.getFunctionType();
-  for (Type *ParamType : FType->params()) {
-    if (ParamType->isPointerTy() &&
-        ParamType->getPointerElementType()->isFunctionTy()) {
-      FuncPointerArgTypes.push_back(ParamType);
-    }
-  }
-
   json::Object DebugDump;
   fillJsonWithFunctionInfo(F, DebugDump);
-  putTypesIntoJson(FuncPointerArgTypes, DebugDump);
-  json::Array storeInstInfoArray;
+  bool HaveFuncPointerTypeArgs = putFunctionArgFuncTypesIntoJson(F, DebugDump);
 
-  unsigned instrumented_count = 0;
+  json::Array StoreInstInfoArray;
+  unsigned InstrumentedCount = 0;
+  SmallVector<std::pair<BasicBlock *, StoreInst *>, 8> BlocksToInstrument{};
   for (StoreInst *SI : Stores) {
-    IRBuilder<> IRB(SI);
-    IRB.SetCurrentDebugLocation(SI->getDebugLoc());
-    Value *StorePtr = SI->getPointerOperand();
     Value *StoredValue = SI->getValueOperand();
-
     if (StoredValue->getType()->isPointerTy())
       if (StoredValue->getType()->getPointerElementType()->isFunctionTy()) {
-        instrumented_count++;
-        IRB.CreateCall(SanCovStoreFPointerFunction,
-                       {
-                           IRB.CreatePointerCast(StorePtr, IntptrTy),
-                           IRB.CreatePointerCast(StoredValue, IntptrTy),
-                       });
-
+        InstrumentedCount++;
+        BasicBlock *BlockOfSI = SI->getParent();
+        BlocksToInstrument.push_back(std::make_pair(BlockOfSI, SI));
         // Only warn about stores that don't map to source code.
         if (SI->getDebugLoc())
-          putStoreInstIntoJson(SI, storeInstInfoArray);
+          putStoreInstIntoJson(SI, StoreInstInfoArray);
       }
   }
-  DebugDump["InstrumentedStores"] = std::move(storeInstInfoArray);
-  if (instrumented_count || FuncPointerArgTypes.size()) {
-    json::Value FinalJson = std::move(DebugDump);
-    std::error_code EC;
-    raw_fd_ostream JSONOut("/tmp/naked_pointers.json", EC, sys::fs::OF_Append);
-    JSONOut << llvm::formatv("{0:2}", FinalJson) << ",\n";
-  }
+  InjectFuncPointerTracesAtBlocks(BlocksToInstrument,
+    DebugDump,
+    StoreInstInfoArray,
+    InstrumentedCount,
+    HaveFuncPointerTypeArgs);
 }
 
 
@@ -1131,20 +1121,10 @@ void ModuleSanitizerCoverage::InjectTraceForNakedFunctionPointerStores(
 //   - stored function pointer
 void ModuleSanitizerCoverage::InjectTraceForShallowFunctionPointerStores(
     Function &F, ArrayRef<StoreInst *> Stores) {
-
-  SmallVector<Type *> FuncPointerArgTypes = {};
-  FunctionType *FType = F.getFunctionType();
-  for (Type *ParamType : FType->params()) {
-    if (ParamType->isPointerTy() &&
-        ParamType->getPointerElementType()->isFunctionTy()) {
-      FuncPointerArgTypes.push_back(ParamType);
-    }
-  }
-
+  json::Array StoreInstInfoArray;
   json::Object DebugDump;
   fillJsonWithFunctionInfo(F, DebugDump);
-  putTypesIntoJson(FuncPointerArgTypes, DebugDump);
-  json::Array StoreInstInfoArray;
+  bool HaveFuncPointerTypeArgs = putFunctionArgFuncTypesIntoJson(F, DebugDump);
 
   unsigned InstrumentedCount = 0;
   SmallVector<std::pair<BasicBlock *, StoreInst *>, 8> BlocksToInstrument{};
@@ -1177,7 +1157,7 @@ void ModuleSanitizerCoverage::InjectTraceForShallowFunctionPointerStores(
     DebugDump,
     StoreInstInfoArray,
     InstrumentedCount,
-    FuncPointerArgTypes);
+    HaveFuncPointerTypeArgs);
 }
 
