+/*
+Returns all intermediate values that appear while stripping pointer casts.
+*/
+SmallVector<Value *, 8> getAllValuesThatWouldBeStripped(Value *V) {
+  SmallPtrSet<const Value *, 8> Visited;
+  SmallVector<Value *, 8> Res;
+  bool CiclicalTypeDetected = false;
+  Visited.insert(V);
+  Res.push_back(V);
+  while (!CiclicalTypeDetected) {
+
+    /*
+    There are four cases we are interested in
+      1. GEPOperator means the pointer can be used to access the same address as
+    a different type
+      2. BitCast Instruction is by definition a type change without modifying
+    the data
+      3. AddressSpaceCast Instruction moves the pointer to a different address
+    space, and can redefine the pointer type
+      4. CallBase Instruction can be interpreted as the Value being of the
+    function return type
+    */
+    if (GEPOperator *GEP = dyn_cast<GEPOperator>(V)) {
+      if (!GEP->hasAllZeroIndices())
+        // In this case a different memory address is accessed
+        // so we cannot handle it as just a type cast
+        return Res;
+      // retrieve the "base" pointer
+      V = GEP->getPointerOperand();
+    } else if (Operator::getOpcode(V) == Instruction::BitCast) {
+      // first operand is the original type
+      Value *NewV = cast<Operator>(V)->getOperand(0);
+      if (!NewV->getType()->isPointerTy()) {
+        Res.push_back(NewV);
+        return Res;
+      }
+      V = NewV;
+    } else if (Operator::getOpcode(V) == Instruction::AddrSpaceCast) {
+      // first operand is the original pointer type
+      V = cast<Operator>(V)->getOperand(0);
+    } else if (CallBase *Call = dyn_cast<CallBase>(V)) {
+      if (Value *RV = Call->getReturnedArgOperand()) {
+        V = RV;
+      } else {
+        return Res;
+      }
+    } else {
+      // There are no other types we want to handle, this is the end.
+      return Res;
+    }
+
+    assert(V->getType()->isPointerTy() && "Unexpected operand type!");
+    Res.push_back(V);
+    CiclicalTypeDetected = !(Visited.insert(V).second);
+  }
+  return Res;
+}
+
+retType getOffsetsFromShallowStructType(StructType *STy) {
+  vectorTypesXOffsets Res;
+  for (unsigned j = 0; j < STy->getNumElements(); j++) {
+    Type *ElemType = STy->getElementType(j);
+    if (ElemType->isPointerTy() &&
+        ElemType->getPointerElementType()->isFunctionTy()) {
+      Res.push_back(std::make_pair(Types{ElemType}, Offsets{j}));
+    }
+  }
+  if (!Res.empty()) {
+    return std::make_pair(true, Res);
+  }
+  return std::make_pair(false, Res);
+}
+
+retType getOffsetsFromPointerToShallowStructType(StructType *STy) {
+  retType StructRes = getOffsetsFromShallowStructType(STy);
+  if (StructRes.first) {
+    vectorTypesXOffsets Res;
+    for (TypesXOffsets Item : StructRes.second) {
+      Types ItemTypes = Item.first;
+      Offsets ItemOffsets = Item.second;
+      ItemTypes.push_back(STy);
+      ItemOffsets.push_back(0);
+      Res.push_back(std::make_pair(ItemTypes, ItemOffsets));
+    }
+    return std::make_pair(true, Res);
+  }
+  return std::make_pair(false, vectorTypesXOffsets{});
+}
+
+retType getOffsetsFromFunctionType(Type *FunctionType) {
+  vectorTypesXOffsets Res = {std::make_pair(Types{FunctionType}, Offsets{0})};
+  return std::make_pair(true, Res);
+}
+
+/*
+Returns:
+  - bool: whether the type can be stripped to a function pointer with some
+offsets
+  - vector: pairs of struct types and offset chains used to access each function
+pointer.
+*/
+retType
+getOneLevelOffsetsFromAllValues(ArrayRef<Value *> PossibleStoredValues) {
+  for (unsigned i = 0; i < PossibleStoredValues.size(); i++) {
+    Type *StoredType = PossibleStoredValues[i]->getType();
+    if (StructType *STy = dyn_cast<StructType>(StoredType)) {
+      // Depth 1: struct possibly containing function pointers
+      return getOffsetsFromShallowStructType(STy);
+    }
+    if (!StoredType->isPointerTy())
+      continue;
+    // else: assume Pointer
+    Type *PointeeType = StoredType->getPointerElementType();
+    if (PointeeType->isIntegerTy())
+      // pointer to int is usually not a type signature we can get function pointers from
+      continue;
+    if (PointeeType->isFunctionTy()) {
+      // Depth 0: naked function pointer
+      return getOffsetsFromFunctionType(PointeeType);
+    } // else: must be struct
+    if (StructType *STy = dyn_cast<StructType>(PointeeType)) {
+      // Depth 1+: pointer to struct possibly containing function pointers
+      return getOffsetsFromPointerToShallowStructType(STy);
+    }
+    if (PointeeType->isPointerTy())
+      // we cannot handle double/triple/nested pointer types in this implementation
+      // TODO: handle this in nested version
+      continue;
+    if (PointeeType->isArrayTy())
+      // we cannot handle array types types in this implementation
+      // TODO: handle this in nested version
+      continue;
+
+    // TODO: handle more types
+    std::string ErrMsg;
+    raw_string_ostream ROS(ErrMsg);
+    ROS << "Unexpected type during function pointer analysis " << *PointeeType << " .\n";
+    report_fatal_error(StringRef(ErrMsg));
+    // unreachable, but makes the compiler complain less
+    return std::make_pair(false, vectorTypesXOffsets{});
+  }
+  return std::make_pair(false, vectorTypesXOffsets{});
+}
