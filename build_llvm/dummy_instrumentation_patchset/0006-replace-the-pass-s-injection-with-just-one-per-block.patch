From f9f899e3c0af1c35930f3efc1e184292ec40e0ae Mon Sep 17 00:00:00 2001
From: Daniel Wappner <dwappner@dc.uba.ar>
Date: Tue, 30 Jun 2026 15:22:51 -0300
Subject: [PATCH 6/6] replace the pass's injection with just one per block

---
 .../Instrumentation/SanitizerCoverage.cpp     | 57 +++++++++++++------
 1 file changed, 41 insertions(+), 16 deletions(-)

diff --git a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
index d1c7fe74a1b4..4366b926a408 100644
--- a/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
+++ b/llvm/lib/Transforms/Instrumentation/SanitizerCoverage.cpp
@@ -25,6 +25,7 @@
 #include "llvm/IR/GlobalVariable.h"
 #include "llvm/IR/IRBuilder.h"
 #include "llvm/IR/InlineAsm.h"
+#include "llvm/IR/Instruction.h"
 #include "llvm/IR/IntrinsicInst.h"
 #include "llvm/IR/Intrinsics.h"
 #include "llvm/IR/LLVMContext.h"
@@ -242,6 +243,7 @@ private:
                                     ArrayRef<StoreInst *> Stores);
   void InjectTraceForNakedFunctionPointerStores(
       Function &F, ArrayRef<StoreInst *> InterestingStores);
+  void InjectFuncPointerTraceAtBlock(BasicBlock *BB, StoreInst *SI);
   void InjectTraceForSwitch(Function &F,
                             ArrayRef<Instruction *> SwitchTraceTargets);
   bool InjectCoverage(Function &F, ArrayRef<BasicBlock *> AllBlocks,
@@ -1020,6 +1022,20 @@ static void fillJsonWithFunctionInfo(Function &F, json::Object &DebugDump) {
   SourceLocation["lineNumber"] = F.getSubprogram()->getScopeLine();
   DebugDump["sourceLocation"] = std::move(SourceLocation);
 }
+
+void ModuleSanitizerCoverage::InjectFuncPointerTraceAtBlock(BasicBlock *BB,
+                                                            StoreInst *SI) {
+  Instruction* Terminator = BB->getTerminator();
+  DebugLoc EntryLoc = Terminator->getDebugLoc();
+  IRBuilder<> IRB(Terminator);
+  IRB.SetCurrentDebugLocation(EntryLoc);
+  IRB.CreateCall(SanCovStoreFPointerFunction,
+                 {
+                     IRB.CreatePointerCast(SI->getPointerOperand(), IntptrTy),
+                     IRB.CreatePointerCast(SI->getValueOperand(), IntptrTy),
+                 });
+}
+
 // On every store to a function pointer variable call we call a run-time
 // function __sanitizer_cov_store_fun_pointer* with two parameters:
 //   - address of the variable,
@@ -1039,31 +1055,40 @@ void ModuleSanitizerCoverage::InjectTraceForNakedFunctionPointerStores(
   json::Object DebugDump;
   fillJsonWithFunctionInfo(F, DebugDump);
   putTypesIntoJson(FuncPointerArgTypes, DebugDump);
-  json::Array storeInstInfoArray;
+  json::Array StoreInstInfoArray;
 
-  unsigned instrumented_count = 0;
+  unsigned InstrumentedCount = 0;
+  SmallVector<std::pair<BasicBlock *, StoreInst *>, 8> BlocksToInstrument{};
   for (StoreInst *SI : Stores) {
-    IRBuilder<> IRB(SI);
-    IRB.SetCurrentDebugLocation(SI->getDebugLoc());
-    Value *StorePtr = SI->getPointerOperand();
     Value *StoredValue = SI->getValueOperand();
-
     if (StoredValue->getType()->isPointerTy())
       if (StoredValue->getType()->getPointerElementType()->isFunctionTy()) {
-        instrumented_count++;
-        IRB.CreateCall(SanCovStoreFPointerFunction,
-                       {
-                           IRB.CreatePointerCast(StorePtr, IntptrTy),
-                           IRB.CreatePointerCast(StoredValue, IntptrTy),
-                       });
-
+        InstrumentedCount++;
+        BasicBlock *BlockOfSI = SI->getParent();
+        BlocksToInstrument.push_back(std::make_pair(BlockOfSI, SI));
         // Only warn about stores that don't map to source code.
         if (SI->getDebugLoc())
-          putStoreInstIntoJson(SI, storeInstInfoArray);
+          putStoreInstIntoJson(SI, StoreInstInfoArray);
       }
   }
-  DebugDump["InstrumentedStores"] = std::move(storeInstInfoArray);
-  if (instrumented_count || FuncPointerArgTypes.size()) {
+  // Turn the array into a set of blocks via sort;unique;
+  std::sort(BlocksToInstrument.begin(), BlocksToInstrument.end(),
+            [](std::pair<BasicBlock *, StoreInst *> T1,
+               std::pair<BasicBlock *, StoreInst *> T2) {
+              return T1.first < T2.first;
+            });
+  std::unique(BlocksToInstrument.begin(), BlocksToInstrument.end(),
+            [](std::pair<BasicBlock *, StoreInst *> T1,
+               std::pair<BasicBlock *, StoreInst *> T2) {
+              return T1.first == T2.first;
+            });
+
+  for (std::pair<BasicBlock *, StoreInst *> Item : BlocksToInstrument) {
+    InjectFuncPointerTraceAtBlock(Item.first, Item.second);
+  }
+
+  DebugDump["InstrumentedStores"] = std::move(StoreInstInfoArray);
+  if (InstrumentedCount || FuncPointerArgTypes.size()) {
     json::Value FinalJson = std::move(DebugDump);
     std::error_code EC;
     raw_fd_ostream JSONOut("/tmp/naked_pointers.json", EC, sys::fs::OF_Append);
-- 
