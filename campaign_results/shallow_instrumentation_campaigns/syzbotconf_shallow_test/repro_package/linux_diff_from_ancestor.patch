+bool kasan_check_range_noreport(const void *addr, size_t size)
+{
+	if (!kasan_arch_is_ready())
+		return true;
+
+	if (unlikely(size == 0))
+		return true;
+
+	if (unlikely(addr + size < addr))
+		return false;
+
+	if (unlikely(!addr_has_metadata(addr)))
+		return false;
+
+	return !memory_is_poisoned(addr, size);
+}
