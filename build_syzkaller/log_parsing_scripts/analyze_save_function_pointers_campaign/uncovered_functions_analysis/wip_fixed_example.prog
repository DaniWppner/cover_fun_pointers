# 1. Create the Netlink socket
r0 = socket$nl_generic(0x10, 0x3, 0x10)

# 2. Get the nl80211 family ID
r1 = syz_genetlink_get_family_id$nl80211(&(0x7f0000000940), 0xffffffffffffffff)

# 3. Retrieve the ifindex of a wireless interface (e.g., wlan0) into r2
r2 = ioctl$sock_SIOCGIFINDEX_80211(r0, 0x8933, &(0x7f0000000200)={"wlan0", 0x0})

# 4. Send the GET_KEY command with the populated NL80211_ATTR_IFINDEX
sendmsg$NL80211_CMD_GET_KEY(r0, &(0x7f00000001c0)={0x0, 0x0, &(0x7f0000000180)={&(0x7f0000000100)={0x1c, r1, 0x211, 0x70bd25, 0x25dfdbfb, {{}, {{0x8, 0x3, r2}, @void}}}, 0x1c}, 0x1, 0x0, 0x0, 0x8014}, 0x40844)