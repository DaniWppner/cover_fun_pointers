+	_, err = client.ReadWriteTransaction(ctx, func(ctx context.Context, tx *spanner.ReadWriteTransaction) error {
+		iter := tx.Query(ctx, spanner.Statement{
+			SQL:    selectJobReporting() + ` WHERE ID = @id`,
