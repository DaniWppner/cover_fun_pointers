+			},
+		}
+		if err := runner.sendRequest(dummyReq); err != nil {
+			return err
+		}
+		runner.lastRequestTime = time.Now()
+		return nil
+	}
+
+	// The runner has no new requests, so don't wait to receive anything from it.
+	time.Sleep(10 * time.Millisecond)
