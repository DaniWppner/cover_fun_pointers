+	assert.NoError(t, err)
+	assert.Len(t, list, 2)
+	assert.True(t, list[0].Direct.Bool)
+	assert.Equal(t, session2.ID, list[0].ID)
+	assert.Equal(t, session1.ID, list[1].ID)
