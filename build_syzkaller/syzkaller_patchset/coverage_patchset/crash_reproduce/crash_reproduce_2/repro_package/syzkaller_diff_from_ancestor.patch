--- /dev/null
+++ b/.github/workflows/stale.yml
@@ -0,0 +1,34 @@
+# Copyright 2026 syzkaller project authors. All rights reserved.
+# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+# https://github.com/actions/stale for details.
+
+name: 'Label stale PRs'
+on:
+  schedule:
+    - cron: '30 1 * * *' # Runs daily at 1:30 AM
+  workflow_dispatch:
+
+jobs:
+  stale:
+    runs-on: ubuntu-latest
+    permissions:
+      pull-requests: write
+    steps:
+      - uses: actions/stale@eb5cf3af3ac0a1aa4c9c45633dd1ae542a27a899 # v10.3.0
+        with:
+          # Disable processing issues entirely
+          days-before-issue-stale: -1
+          days-before-issue-close: -1
+
+          # Configure stale PR labeling
+          days-before-pr-stale: 90
+          # Disable automatic closing of PRs
+          days-before-pr-close: -1
+          stale-pr-message: 'This PR is stale because it has been open 90 days with no activity.'
+          stale-pr-label: 'stale'
+
+          # Max operations per run to cover all open PRs in a single run
+          operations-per-run: 200
+          # Fetch oldest PRs first to prioritize finding stale ones
+          ascending: true
