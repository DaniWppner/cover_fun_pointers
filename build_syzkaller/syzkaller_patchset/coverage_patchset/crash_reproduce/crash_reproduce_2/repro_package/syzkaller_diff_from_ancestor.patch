+func (pass *Pass) checkMapKeysExtractionAndSort(n *ast.BlockStmt) {
+	for i := range len(n.List) - 1 {
+		rangeStmt, ok := n.List[i].(*ast.RangeStmt)
+		if !ok {
+			continue
+		}
+		sliceIdent, ok := pass.isMapKeysExtraction(rangeStmt)
+		if !ok {
