+	if err := checkEmailRateLimit(ctx, msg); err != nil {
+		return fmt.Errorf("email rate limit exceeded: %w", err)
+	}
 	if err := aemail.Send(ctx, msg); err != nil {
 		return fmt.Errorf("failed to send email: %w", err)
 	}
