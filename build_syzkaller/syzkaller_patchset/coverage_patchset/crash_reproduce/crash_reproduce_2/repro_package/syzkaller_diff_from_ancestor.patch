+	dev_id			DEV_ID
+	ublk_pid		pid
+	pad1			const[0, int32]
+	flags			flags[ublk_f_flags, int64]
+	ublk_flags		const[0, int64]
+	owner_uid		const[0, int32]
+	owner_gid		const[0, int32]
+	reserved1		const[0, int64]
+	reserved2		const[0, int64]
