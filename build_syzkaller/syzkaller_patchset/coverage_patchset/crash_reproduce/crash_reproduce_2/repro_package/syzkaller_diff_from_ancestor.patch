+func getManualWorkflowSpec(cfg *Config, name string) *ManualWorkflowSpec {
+	specs := manualAIWorkflows(cfg)
+	if i := slices.IndexFunc(specs, func(s ManualWorkflowSpec) bool { return s.Name == name }); i != -1 {
+		return &specs[i]
+	}
+	return nil
+}
