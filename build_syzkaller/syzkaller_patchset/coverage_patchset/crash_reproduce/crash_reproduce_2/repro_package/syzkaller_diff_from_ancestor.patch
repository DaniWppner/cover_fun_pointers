+func (ctx *Ctx) setupAIPatchJob(t *testing.T) (string, string) {
+	t.Helper()
+	build := testBuild(1)
+	ctx.aiClient.UploadBuild(build)
+	crash := testCrashWithRepro(build, 1)
+	ctx.aiClient.ReportCrash(crash)
